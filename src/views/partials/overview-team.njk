<div class="stats">
  <div class="stat">
    <span class="stat__label">Опитування</span>
    <span class="stat__value">{{ surveyTotal }}</span>
    <span class="stat__note">{{ activeCount }} активних</span>
  </div>
  <div class="stat">
    <span class="stat__label">Відповіді</span>
    <span class="stat__value">{{ totals.attempts }}</span>
    <span class="stat__note">{{ totals.last7 }} за останній тиждень</span>
  </div>
  <div class="stat">
    <span class="stat__label">Учасники</span>
    <span class="stat__value">{{ totals.participants }}</span>
    <span class="stat__note">різних людей</span>
  </div>
  <div class="stat">
    <span class="stat__label">Відповідей на анкету</span>
    <span class="stat__value">{{ (totals.answers / totals.attempts) | round(1) if totals.attempts else '—' }}</span>
    <span class="stat__note">у середньому</span>
  </div>
</div>

<div class="overview-grid">
  <div class="stack">
    <section class="panel">
      <div class="panel__head">
        <h2>Відповіді за сім днів</h2>
        <span class="small muted">{{ totals.last7 }} за тиждень</span>
      </div>
      <div class="panel__body">
        {% if totals.attempts %}
          <div class="chart" role="img" aria-label="Кількість відповідей за останні сім днів">
            {% for day in daily %}
              {% set height = (day.count * 100 / dailyMax) | round %}
              <div class="chart__col" title="{{ day.date }}: {{ day.count }}">
                <div class="chart__bar" style="height: {{ 4 if day.count == 0 else height }}%"></div>
                <span class="chart__label">{{ day.date | formatShortDate }}</span>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <div class="chart__empty">Відповіді з’являться тут після першої участі.</div>
        {% endif %}
      </div>
    </section>

    <section class="panel">
      <div class="panel__head">
        <h2>Ваші опитування</h2>
        <a class="link" href="/studio/surveys">Усі {{ icon('arrow-right', 13) }}</a>
      </div>
      <div class="mini-list">
        {% for survey in surveys %}
          <div class="mini-row">
            <div class="mini-row__main">
              <a class="mini-row__title" href="/studio/surveys/{{ survey.id }}">{{ survey.title }}</a>
              <span class="mini-row__meta">{{ survey.category.name if survey.category else 'Без теми' }} · {{ counts[survey.id] }} {{ counts[survey.id] | responseWord }}</span>
            </div>
            <span class="chip chip--{{ survey.status | statusTone }}">{{ survey.status | statusLabel }}</span>
          </div>
        {% else %}
          <div class="empty-state">
            <span class="empty-state__mark">{{ icon('plus', 24) }}</span>
            <h3>Ще немає опитувань</h3>
            <p>Перше опитування можна створити за кілька хвилин: назва, тема і питання.</p>
            <a class="btn btn--primary btn--sm" href="/studio/surveys?new=1">Створити</a>
          </div>
        {% endfor %}
      </div>
    </section>
  </div>

  <div class="stack">
    <section class="panel">
      <div class="panel__head">
        <h2>Останні відповіді</h2>
        <a class="link" href="/studio/responses">До журналу {{ icon('arrow-right', 13) }}</a>
      </div>
      <div class="activity">
        {% for item in activity %}
          <div class="activity__row">
            <span class="activity__avatar">{% if item.anonymous %}{{ icon('shield', 15) }}{% else %}{{ item.name | initials }}{% endif %}</span>
            <div class="activity__main">
              <div class="activity__name">{{ item.name }}</div>
              <div class="activity__survey">{{ item.surveyTitle }}</div>
            </div>
            <span class="activity__time">{{ item.answeredAt | relativeTime }}</span>
          </div>
        {% else %}
          <div class="row-empty">Відповідей поки немає.</div>
        {% endfor %}
      </div>
    </section>

    {% if mode == 'admin' and platform %}
      <section class="panel">
        <div class="panel__head">
          <h2>Платформа</h2>
          <a class="link" href="/studio/people">Люди {{ icon('arrow-right', 13) }}</a>
        </div>
        <div class="panel__body" style="display:grid; gap:14px;">
          <div class="builder__meta-row"><span>Опитувань усього</span><strong>{{ platform.surveys }}</strong></div>
          <div class="builder__meta-row"><span>Дослідників</span><strong>{{ platform.creators }}</strong></div>
          <div class="builder__meta-row"><span>Облікових записів</span><strong>{{ platform.users }}</strong></div>
          <div class="builder__meta-row"><span>Категорій</span><strong>{{ platform.categories }}</strong></div>
          <div class="builder__meta-row"><span>Заповнених анкет</span><strong>{{ platform.attempts }}</strong></div>
        </div>
      </section>

      {% if creators and creators.length %}
        <section class="panel">
          <div class="panel__head"><h2>Дослідники</h2></div>
          <div class="mini-list">
            {% for creator in creators %}
              <div class="mini-row">
                <span class="activity__avatar">{{ creator.full_name | initials }}</span>
                <div class="mini-row__main">
                  <span class="mini-row__title">{{ creator.full_name }}</span>
                  <span class="mini-row__meta">{{ creator.surveys }} {{ creator.surveys | surveyWord }}</span>
                </div>
              </div>
            {% endfor %}
          </div>
        </section>
      {% endif %}
    {% else %}
      <section class="panel panel--pad">
        <h2 style="font-size: 15px;">Анонімність</h2>
        <p class="small muted" style="margin-top: 8px;">Якщо автор дозволив анонімність, учасник сам обирає, прикріплювати відповідь до профілю чи ні. Ви бачите ім’я лише тоді, коли учасник відповідав не анонімно.</p>
        <div style="margin-top: 14px;">
          <a class="link" href="/studio/responses">Подивитися відповіді {{ icon('arrow-right', 14) }}</a>
        </div>
      </section>
    {% endif %}
  </div>
</div>
