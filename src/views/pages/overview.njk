{% extends "layouts/base.njk" %}

{% block content %}
<div class="wrap page">
  <header class="page-head">
    <div>
      <p class="page-head__eyebrow">{{ icon('grid', 14) }} Кабінет · {{ currentUser.role | roleLabel }}</p>
      <h1>Вітаю, {{ currentUser.full_name | firstName }}</h1>
      <p>
        {% if mode == 'visitor' %}
          Тут зібрані ваші відповіді та опитування, які зараз приймають участь.
        {% else %}
          Ось що відбувається з вашими опитуваннями. Дані оновлюються після кожної нової відповіді.
        {% endif %}
      </p>
    </div>
    <div class="page-head__actions">
      {% if mode == 'visitor' %}
        <a class="btn btn--primary" href="/surveys">Пройти опитування {{ icon('arrow-right', 16) }}</a>
      {% else %}
        <a class="btn btn--quiet" href="/studio/responses">{{ icon('inbox', 16) }} Відповіді</a>
        <a class="btn btn--primary" href="/studio/surveys?new=1">{{ icon('plus', 16) }} Нове опитування</a>
      {% endif %}
    </div>
  </header>

  {% if mode == 'visitor' %}
    {% include "partials/overview-visitor.njk" %}
  {% else %}
    {% include "partials/overview-team.njk" %}
  {% endif %}
</div>
{% endblock %}
