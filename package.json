{
  "name": "kolo-survey-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Kolo — платформа онлайн-опитувань для команд і спільнот",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node scripts/setup-db.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/setup-db.mjs --reset",
    "test:flows": "node scripts/test-flows.mjs",
    "test:api": "node scripts/test-api.mjs",
    "test:users": "node scripts/test-user-flows.mjs",
    "shoot": "node scripts/shoot.mjs",
    "check:sizes": "node scripts/check-file-sizes.mjs",
    "check": "node --check src/server.js"
  },
  "author": "Бурик Назар",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "nunjucks": "^3.2.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.0",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "playwright-core": "^1.65.1"
  }
}
