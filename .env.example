# Рядок підключення PostgreSQL (Render або локальний, обов'язково)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Секрети сесій та JWT (генеруються окремо для кожного середовища)
SESSION_SECRET=
JWT_SECRET=

# Публічна адреса застосунку
APP_ORIGIN=http://localhost:3000
PORT=3000
NODE_ENV=development
